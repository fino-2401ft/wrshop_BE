# Postgres local, database wrshop, user postgres, cổng 5432.
# Nếu mật khẩu có ký tự @ thì phải URL-encode thành %40 trong DATABASE_URL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/wrshop?schema=public
JWT_SECRET=doi-chuoi-nay
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Phiên admin (cookie HttpOnly). Mặc định 8 giờ.
AUTH_SESSION_HOURS=8
# true/false — để trống thì theo x-forwarded-proto / HTTPS thực tế.
COOKIE_SECURE=
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
SEED_DEMO=true

# Cloudflare R2. Để trống khi dev: ảnh lưu tạm trong uploads/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SePay — tài khoản ACB nhận thanh toán mua account
# Nội dung CK mỗi đơn: WR + 8 ký tự ngẫu nhiên, ví dụ WR4F8K2M9A
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=ACB
SEPAY_ACCOUNT_NAME=
SEPAY_CODE_PREFIX=WR
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
