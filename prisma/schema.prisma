generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  INSTALLMENT
  ABANDONED
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ShopCategory {
  id        String    @id @default(cuid())
  code      String    @unique
  slug      String    @unique
  title     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  accounts  Account[]
}

model Account {
  id           String         @id @default(cuid())
  publicCode   Int            @unique @default(autoincrement())
  categoryId   String
  shopCategory ShopCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price        Int
  description  String         @default("")
  specs        Json
  gameUser     String
  gamePass     String
  status       AccountStatus  @default(AVAILABLE)
  contributed  Int            @default(0)
  buyerName    String         @default("")
  buyerEmail   String         @default("")
  buyerPhone   String         @default("")
  cost           Int            @default(0)
  profit         Int            @default(0)
  consignment    Boolean        @default(false)
  isHot          Boolean        @default(false)
  dueAt          DateTime?
  reminded3dAt   DateTime?
  remindedDueAt  DateTime?
  images         AccountImage[]
  orders       Order[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId, status, createdAt])
  @@index([status, price])
}

model AccountImage {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key       String
  url       String
  sortOrder Int
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([accountId, sortOrder])
}

model Order {
  id                String      @id @default(cuid())
  code              String      @unique
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  phone             String      @default("")
  email             String?
  buyerName         String      @default("")
  amount            Int
  status            OrderStatus @default(PENDING)
  paidTransactionId String?     @unique
  settlementAmount  Int?
  reclaimed         Boolean     @default(false)
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime    @default(now())

  @@index([status, createdAt])
}
